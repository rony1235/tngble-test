{
  "name": "tngble",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": "^22.13.0 || >=24.3.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint src/domain src/infrastructure src/application src/presentation src/providers src/shared tests/unit tests/integration tests/component app.config.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:no-only": "node ./scripts/assert-no-only.js",
    "quality": "pnpm typecheck && pnpm lint && pnpm test:no-only && pnpm test:coverage",
    "testlab:android": "bash ./scripts/firebase-test-lab.sh",
    "testlab:android:latest": "DOWNLOAD_LATEST=1 bash ./scripts/firebase-test-lab.sh",
    "build:android:testlab": "pnpm dlx eas-cli build --platform android --profile testlab",
    "build:ios:appetize": "mkdir -p .artifacts/appetize && pnpm dlx eas-cli build --platform ios --profile appetize --local --output ./.artifacts/appetize/app.tar.gz",
    "build:ios:appetize:cloud": "pnpm dlx eas-cli build --platform ios --profile appetize",
    "appetize:ios": "bash ./scripts/appetize-ios.sh",
    "appetize:ios:local": "LOCAL=1 bash ./scripts/appetize-ios.sh",
    "appetize:ios:latest": "DOWNLOAD_LATEST=1 bash ./scripts/appetize-ios.sh",
    "doctor": "npx expo-doctor",
    "typecheck": "tsc --noEmit"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-bootsplash"
      ]
    }
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/test/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^.+\\.svg$": "<rootDir>/test/svgMock.js",
      "^react-native-auth0$": "<rootDir>/test/auth0Mock.js",
      "^expo-screen-capture$": "<rootDir>/test/screenCaptureMock.js"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/",
      "/tests/e2e/"
    ],
    "collectCoverageFrom": [
      "src/domain/**/*.{ts,tsx}",
      "src/infrastructure/**/*.{ts,tsx}",
      "src/application/**/*.{ts,tsx}",
      "src/presentation/**/*.{ts,tsx}",
      "src/providers/**/*.{ts,tsx}",
      "!**/index.ts",
      "!**/types.ts",
      "!**/AuthService.ts",
      "!**/User.ts",
      "!**/Auth0DevSmokePanel.tsx",
      "!**/auth0Smoke.ts",
      "!**/AuthProvider.tsx",
      "!**/AppProviders.tsx",
      "!**/Auth0AppProvider.tsx",
      "!**/LocalConsentStore.ts",
      "!**/SecureStorage.ts",
      "!**/tokenAccessor.ts",
      "!**/useAuthState.ts",
      "!**/useRefreshVerification.ts",
      "!**/useResendVerification.ts",
      "!**/useRestoreSession.ts",
      "!**/useSignOut.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 65,
        "functions": 80,
        "lines": 80
      },
      "./src/domain/auth/": {
        "statements": 90,
        "branches": 75,
        "functions": 90,
        "lines": 90
      },
      "./src/domain/sanitization/": {
        "statements": 90,
        "branches": 80,
        "functions": 90,
        "lines": 90
      }
    }
  },
  "dependencies": {
    "@react-native-picker/picker": "2.11.4",
    "expo": "~57.0.22",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-screen-capture": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-auth0": "^5.11.1",
    "react-native-bootsplash": "7.3.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-phone-input": "^1.4.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "~0.86.3",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^26.6.2",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "fast-check": "^4.10.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "react-native-svg-transformer": "^1.5.3",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react-dom"
      ],
      "allowedVersions": {
        "react-dom": "*"
      }
    }
  }
}
