{
  "name": "tngble",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": "^22.13.0 || >=24.3.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "testlab:android": "bash ./scripts/firebase-test-lab.sh",
    "testlab:android:latest": "DOWNLOAD_LATEST=1 bash ./scripts/firebase-test-lab.sh",
    "build:android:testlab": "eas build --platform android --profile testlab",
    "build:ios:appetize": "mkdir -p .artifacts/appetize && eas build --platform ios --profile appetize --local --output ./.artifacts/appetize/app.tar.gz",
    "build:ios:appetize:cloud": "eas build --platform ios --profile appetize",
    "appetize:ios": "bash ./scripts/appetize-ios.sh",
    "appetize:ios:local": "LOCAL=1 bash ./scripts/appetize-ios.sh",
    "appetize:ios:latest": "DOWNLOAD_LATEST=1 bash ./scripts/appetize-ios.sh",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^.+\\.svg$": "<rootDir>/test/svgMock.js"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ]
  },
  "dependencies": {
    "expo": "~57.0.19",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.18",
    "expo-secure-store": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-bootsplash": "7.3.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "~0.86.3",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.0",
    "eas-cli": "^23.2.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "react-native-svg-transformer": "^1.5.3",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react-dom"
      ],
      "allowedVersions": {
        "react-dom": "*"
      }
    }
  }
}
