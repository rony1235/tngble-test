EXPO_PUBLIC_API_URL=http://localhost:3000

# Auth0 public client config (Native app). Required for AUTH-01.
# See docs/auth0-phase-0-prerequisites.md
EXPO_PUBLIC_AUTH0_DOMAIN=
EXPO_PUBLIC_AUTH0_CLIENT_ID=
# Optional — only if you have a backend API identifier. Not required for RN-only apps.
# EXPO_PUBLIC_AUTH0_AUDIENCE=

# Signup verification uses Auth0 classic Passwordless Email plus a Post-Login linking Action.
# Forgot-password: Passwordless OTP + in-app new password via Auth0 My Account API
# (enable https://YOUR_DOMAIN/me/ and create:me:authentication_methods). No custom API.

# Deprecated for product auth (AUTH-01). Prefer FakeAuthAdapter in tests.
# Production EAS profile forces false. Do not use for new Auth0 work.
EXPO_PUBLIC_USE_MOCK_AUTH=true

# Firebase Test Lab (Android Robo) — see docs/firebase-test-lab.md
# Project id from Firebase console (Project settings → General)
FIREBASE_PROJECT_ID=
# Optional overrides (defaults are fine for Spark / smoke runs)
# TESTLAB_TIMEOUT=5m
# TESTLAB_TYPE=robo
# TESTLAB_DEVICES=model=MediumPhone.arm,version=34,locale=en,orientation=portrait
# EAS_PROFILE=testlab

# Appetize (iOS Simulator) — see docs/appetize-ios.md
# Organization → API Token
APPETIZE_API_TOKEN=
# Optional: reuse the same Appetize app URL on later uploads
# APPETIZE_PUBLIC_KEY=
# Optional: override EAS profile (default: appetize)
# EAS_PROFILE=appetize
