EXPO_PUBLIC_API_URL=http://localhost:3000
# Set to false when the real backend /auth/login is ready
EXPO_PUBLIC_USE_MOCK_AUTH=true

# Firebase Test Lab (Android Robo) — see docs/firebase-test-lab.md
# Project id from Firebase console (Project settings → General)
FIREBASE_PROJECT_ID=
# Optional overrides (defaults are fine for Spark / smoke runs)
# TESTLAB_TIMEOUT=5m
# TESTLAB_TYPE=robo
# TESTLAB_DEVICES=model=MediumPhone.arm,version=34,locale=en,orientation=portrait
# EAS_PROFILE=testlab

# Appetize (iOS Simulator) — see docs/appetize-ios.md
# Organization → API Token
APPETIZE_API_TOKEN=
# Optional: reuse the same Appetize app URL on later uploads
# APPETIZE_PUBLIC_KEY=
# Optional: override EAS profile (default: appetize)
# EAS_PROFILE=appetize
